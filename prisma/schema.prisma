generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
    id      Int @id @default(autoincrement())
    name String
    description String?
    folderPath String
    creationTime DateTime @default(now())
    files MediaFile[]
}

model MediaFile {
    id Int @id @default(autoincrement())
    fileName String
    filePath String
    fileType String
    creationTime DateTime @default(now())
    projectID Int?
    project Project? @relation(fields: [projectID], references: [id])
}