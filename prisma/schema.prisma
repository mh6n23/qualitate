// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  url = env("postgresql://postgres:12March2006@localhost:5432/postgres")
}

datasource db {
  provider = "postgresql"
}

model Project {
    id      Int @id @default(autoincrement())
    name String
    description String?
    folderPath String
    creationTime DateTime @default(now())

    files MediaFile[]
    codes Code[]
    annotations Annotation[]
}

model MediaFile {
    id Int @id @default(autoincrement())
    fileName String
    filePath String
    fileType String
    creationTime DateTime @default(now())
    duration Float @default(0)
    projectID Int
    project Project @relation(fields: [projectID], references: [id])

    transcriptAnnotations Annotation[] @relation("TranscriptSource")
    annotationLinks AnnotationMediaLink[]
}

model Code {
    id Int @id @default(autoincrement())
    name String
    description String?
    colour String
    projectID Int

    project Project @relation(fields: [projectID], references: [id])
    annotations Annotation[]

    @@unique([projectID, name])
}

model Annotation {
    id Int @id @default(autoincrement())
    projectID Int
    codeID Int
    startTime Float
    endTime Float
    transcriptFileID Int?
    transcriptStartLine Int?
    transcriptEndLine Int?
    selectedText String?
    creationTime DateTime @default(now())

    project Project @relation(fields: [projectID], references: [id])
    code Code  @relation(fields: [codeID], references: [id])
    transcriptFile MediaFile? @relation("TranscriptSource", fields: [transcriptFileID], references: [id])
    mediaLinks AnnotationMediaLink[]
}

model AnnotationMediaLink {
    id Int @id @default(autoincrement())
    annotationID Int
    mediaFileID Int

    annotation Annotation @relation(fields: [annotationID], references: [id])
    mediaFile MediaFile @relation(fields: [mediaFileID], references: [id])

    @@unique([annotationID, mediaFileID])
}