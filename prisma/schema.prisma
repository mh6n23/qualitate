// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

model Project {
    id      Int @id @default(autoincrement())
    name String
    description String?
    folderPath String
    creationTime DateTime @default(now())

    files MediaFile[]
    codes Code[]
    annotations Annotation[]
    themes Theme[]
    events Event[]
    groups Group[]
}

model Event {
    id Int @id @default(autoincrement())
    name String
    projectID Int
    project Project @relation(fields: [projectID], references: [id])
    files MediaFile[]
    annotations Annotation[]
    @@unique([projectID, name])
}

model Group {
    id Int @id @default(autoincrement())
    name String
    projectID Int
    project Project @relation(fields: [projectID], references: [id])
    files MediaFile[]
    annotations Annotation[]
    @@unique([projectID, name])
}

model MediaFile {
    id Int @id @default(autoincrement())
    fileName String
    filePath String
    fileType String
    creationTime DateTime @default(now())
    duration Float @default(0)
    projectID Int
    eventID Int?
    groupID Int?

    project Project @relation(fields: [projectID], references: [id])
    event Event? @relation(fields: [eventID], references: [id])
    group Group? @relation(fields: [groupID], references: [id])

    transcriptAnnotations Annotation[] @relation("TranscriptSource")
    annotationLinks AnnotationMediaLink[]
}

model Theme {
    id Int @id @default(autoincrement())
    name String
    description String?
    projectID Int

    project Project @relation(fields: [projectID], references: [id])
    codeLinks ThemeCode[]

    @@unique([projectID, name])
}

model ThemeCode {
    id Int @id @default(autoincrement())
    themeID Int
    codeID Int
    theme Theme @relation(fields: [themeID], references: [id])
    code Code @relation(fields: [codeID], references: [id])

    @@unique([themeID, codeID])
}

model Code {
    id Int @id @default(autoincrement())
    name String
    description String?
    colour String
    projectID Int

    project Project @relation(fields: [projectID], references: [id])
    annotations Annotation[]
    themeLinks ThemeCode[]

    @@unique([projectID, name])
}

model Annotation {
    id Int @id @default(autoincrement())
    projectID Int
    codeID Int
    startTime Float
    endTime Float
    transcriptFileID Int?
    transcriptStartLine Int?
    transcriptEndLine Int?
    selectedText String?
    transcriptStartOffset Int?
    transcriptEndOffset Int?
    creationTime DateTime @default(now())

    eventID Int
    groupID Int

    project Project @relation(fields: [projectID], references: [id])
    code Code  @relation(fields: [codeID], references: [id])
    event Event @relation(fields: [eventID], references: [id])
    group Group @relation(fields: [groupID], references: [id])
    transcriptFile MediaFile? @relation("TranscriptSource", fields: [transcriptFileID], references: [id])
    mediaLinks AnnotationMediaLink[]
}

model AnnotationMediaLink {
    id Int @id @default(autoincrement())
    annotationID Int
    mediaFileID Int

    annotation Annotation @relation(fields: [annotationID], references: [id])
    mediaFile MediaFile @relation(fields: [mediaFileID], references: [id])

    @@unique([annotationID, mediaFileID])
}